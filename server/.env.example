PORT=5000
NODE_ENV=development
FRONTEND_BASE_URL=http://localhost:3000

# 🔐 CORS Configuration
CORS_ORIGIN=http://pikzee-client:3000
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=Content-Type,Authorization
CORS_CREDENTIALS=true

# Database Configuration
DATABASE_URL=postgresql://nikhilenigma:root@localhost:5432/pikzee_db

POSTGRES_USER=nikhilenigma
POSTGRES_PASSWORD=root
POSTGRES_DB=pikzee_db

# Clerk Configuration
# Add your Clerk API keys here
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key
CLERK_WEBHOOK_SIGNING_SECRET=your_clerk_webhook_signing_secret


# AWS S3 Configuration
AWS_REGION='ap-south-1' 
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_PUBLIC_BUCKET=your_public_bucket_name
AWS_PRIVATE_BUCKET=your_private_bucket_name
SIGNED_URL_EXPIRATION=3600 # 1 hour in seconds

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI='http://localhost:3000/media-manager/oauth/callback'

# Novu Configuration
NOVU_SECRET_KEY=your_novu_secret_key
NOVU_APP_ID=your_novu_app_id # Pikzee App ID

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key

# Resend Configuration
RESEND_API_KEY=your_resend_api_key

# Invitation Token Configuration
INVITATION_TOKEN_SECRET=your_invitation_token_secret
ENCRYPTION_KEY=your_encryption_key_for_sensitive_data


# Unsplash API Configuration
UNSPLASH_ACCESS_KEY=your_unsplash_access_key
UNSPLASH_SECRET_KEY=your_unsplash_secret_key

# npx localtunnel -s domain --port 8080 for webhook testing