
VITE_PORT=3000

# CLIENT SIDE
VITE_ENV=development # production or development or test
VITE_BACKEND_PROXY=http://localhost:8080/api/v1

# Clerk Configuration
VITE_CLERK_PUBLISHABLE_KEY=your-clerk-publishable-key

# OAuth Credentials for Google and GitHub
